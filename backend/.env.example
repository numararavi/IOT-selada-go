PORT=5000
MQTT_BROKER_URL=mqtt://broker.emqx.io:1883

# -----------------------------------------------------------------------------------
# OPSI DATABASE POSTGRESQL (Supabase / Neon / Render Postgres)
# Masukkan connection string PostgreSQL Anda di bawah ini:
# Contoh Supabase:
# DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# -----------------------------------------------------------------------------------
# DATABASE_URL=

# Opsi SQLite Lokal (Otomatis aktif jika DATABASE_URL tidak diisi)
DATABASE_PATH=./data/hydroponic.db
DB_SSL=true
